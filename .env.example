# Copy this file to .env and fill in the values from
# Firebase console > Project settings > General > Your apps > SDK setup and configuration > Config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (reCAPTCHA Enterprise site key). Leave blank for local dev; the debug provider is used on localhost.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
